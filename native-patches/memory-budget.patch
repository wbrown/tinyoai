+// Called under the allocator mutex. Sample the OS at most every 100 ms;
+// every allocation still accounts for its bytes against that sampled budget.
+// This is telemetry cadence, not a cap on a training example or live tensor.
+size_t refresh_machine_budget(size_t owned) {
+  using Clock = std::chrono::steady_clock;
+  static auto sampled = Clock::time_point::min();
+  static uint64_t physical = 0;
+  const auto now = Clock::now();
+  if (sampled != Clock::time_point::min() &&
+      now - sampled < std::chrono::milliseconds(100)) {
+    return machine_budget.load(std::memory_order_relaxed);
+  }
+  if (physical == 0) {
+    size_t n = sizeof(physical);
+    if (sysctlbyname("hw.memsize", &physical, &n, nullptr, 0) != 0) {
+      std::fprintf(stderr,"MLX headroom: physical RAM query failed; idle caching disabled until next successful sample\n");
+      machine_budget.store(0, std::memory_order_relaxed); sampled = now; return 0;
+    }
+  }
+  vm_statistics64_data_t vm{};
+  mach_msg_type_number_t count = HOST_VM_INFO64_COUNT;
+  const auto host = mach_host_self();
+  auto status = host_statistics64(host, HOST_VM_INFO64,
+      reinterpret_cast<host_info64_t>(&vm), &count);
+  mach_port_deallocate(mach_task_self(), host);
+  if (status != KERN_SUCCESS) {
+    std::fprintf(stderr,"MLX headroom: available RAM query failed (%d); idle caching disabled until next successful sample\n",status);
+    machine_budget.store(0, std::memory_order_relaxed); sampled = now; return 0;
+  }
+  // Inactive includes anonymous Metal buffers belonging to this allocator.
+  // They are not disposable: counting them as available double-counts owned
+  // memory and can exhaust the compressor when GPU residency is withdrawn.
+  // Only free and explicitly purgeable pages provide immediate headroom.
+  auto available = (uint64_t(vm.free_count) + vm.purgeable_count) * vm_page_size;
+  auto limit = headroom::budget(physical, available, owned);
+  machine_budget.store(limit, std::memory_order_relaxed);
+  sampled = now;
+  return limit;
+}
